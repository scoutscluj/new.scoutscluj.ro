---
import type { HomePageData } from '../../types/content';

interface Props {
  utility: HomePageData['utility'];
}

const { utility } = Astro.props;

const visibilityClass = {
  all: 'utility-visible-all',
  sm: 'utility-visible-sm',
  md: 'utility-visible-md',
  lg: 'utility-visible-lg',
  xl: 'utility-visible-xl',
  '2xl': 'utility-visible-2xl'
}[utility.visibility ?? 'all'];
---

<div class:list={['utility', visibilityClass]}>
  <div class="container utility-inner">
    <span class="utility-left">{utility.leftText}</span>
    <div class="utility-right">
      <a href={`mailto:${utility.email}`}>{utility.email}</a>
      <span aria-hidden="true">·</span>
      <a href={`tel:${utility.phone.replace(/\s+/g, '')}`}>{utility.phone}</a>
    </div>
  </div>
</div>
